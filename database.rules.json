{
  "rules": {
    "drivers": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'",
        ".validate": "newData.hasChildren(['name', 'phone', 'people', 'status'])",
        "people": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7" }
      }
    },
    "ads": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'admin@213damas.uz'"
    },
    "passengers": {
      ".read": true,
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || (!newData.exists() && now - data.child('since').val() > 2400000))",
        ".validate": "!newData.exists() || newData.hasChildren(['lat', 'lng', 'since', 'uid'])"
      }
    },
    "online": {
      ".read": "auth != null && auth.token.email === 'admin@213damas.uz'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "stats": {
      ".read": "auth != null && auth.token.email === 'admin@213damas.uz'",
      "daily": {
        "$day": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === true"
          }
        }
      },
      "adViews": {
        "$ad": { "$day": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        } }
      },
      "adClicks": {
        "$ad": { "$day": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        } }
      }
    }
  }
}
